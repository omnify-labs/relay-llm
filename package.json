{
  "name": "relay-llm",
  "version": "0.1.0",
  "description": "A thin, transparent LLM proxy with zero format translation",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest",
    "prices:check": "tsx scripts/litellm-prices-check.ts",
    "test:coverage": "vitest run --coverage --coverage.include=src/**",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "test:database": "tsx scripts/test-edge-database.ts",
    "test:live": "tsx scripts/test-edge-live.ts",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy --config wrangler.staging.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.14",
    "jose": "^6.2.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.69",
    "@cloudflare/workers-types": "5.20261027.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "prettier": "3.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=20"
  }
}
